# Types the engine writes beside a loaded mod
.claude-plugin/types/

# Written by the maintainer's script that keeps a daily-build checkout on the next branch, into the root, codex/plugin
# and omp, so each look's version label says "next" (NEXT_BUILD_MARK in hooks/view.ts)
.next-build

# Throwaway scripts that import the mod's code, so they live inside the repo
.scratch/

# The Codex plugin's tools and test bundles; its plugin/dist bundles are committed
codex/node_modules/
codex/test-dist/

# The omp extension's tools
omp/node_modules/

# The tab page `npm --prefix codex run dev` keeps built
codex/.dev/

# Eval results, written on every run
evals/results/

# The video project's tools, renders, takes and cut clips, which its scripts make again
videos/node_modules/
videos/out/
videos/takes
videos/public/*/takes
videos/public/*/stills
# Music licensed for the post, not for sharing in this repo
videos/public/music
# App icons copied from the installed apps, which are their makers' trademarks
videos/public/icons
