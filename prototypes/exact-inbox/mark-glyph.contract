use markPulse from "./motion.contract"

component MarkGlyph
  props
    mark: string
    color: string
    running: bool
    reduced: bool
    size: number
  view
    if running
      svg width=size height=size viewBox="0 0 8 8" animation=markPulse(reduced, true)
        circle cx=4 cy=4 r=3.1 fill=color
    else if mark == "✓"
      svg width=size height=size viewBox="-0.5 -0.5 9 9"
        polyline points="0.6,4.4 3,6.8 7.4,1.4" fill="none" stroke=color stroke-width=1.4 stroke-linecap="round" stroke-linejoin="round"
    else if mark == "☑"
      svg width=size height=size viewBox="0 0 8 8"
        rect x=1 y=1 width=6 height=6 rx=1.3 fill="none" stroke=color stroke-width=0.95 stroke-linecap="round" stroke-linejoin="round"
        polyline points="2.4,4.1 3.6,5.3 5.7,2.8" fill="none" stroke=color stroke-width=1.1 stroke-linecap="round" stroke-linejoin="round"
    else if mark == "▲"
      svg width=size height=size viewBox="0 0 8 8"
        polygon points="4,0.6 7.8,7.4 0.2,7.4" fill=color
    else if mark == "✦"
      svg width=size height=size viewBox="0 0 8 8"
        path d="M4,0 Q4.6,3.4 8,4 Q4.6,4.6 4,8 Q3.4,4.6 0,4 Q3.4,3.4 4,0 Z" fill=color
    else if mark == "✗"
      svg width=size height=size viewBox="-0.5 -1 9 10"
        path d="M1.2,8.2 Q3.4,4.4 7.4,-0.2" fill="none" stroke=color stroke-width=1.9 stroke-linecap="round" stroke-linejoin="round"
        path d="M2.2,1.4 Q3.8,4.4 5.6,7.4" fill="none" stroke=color stroke-width=1.6 stroke-linecap="round" stroke-linejoin="round"
    else if mark == "◌"
      svg width=size height=size viewBox="0 0 8 8"
        circle cx=4 cy=4 r=3.1 fill="none" stroke=color stroke-width=1.25 stroke-dasharray="1.5 1.1"
    else if mark == "⊘"
      svg width=size height=size viewBox="0 0 8 8"
        circle cx=4 cy=4 r=3.1 fill="none" stroke=color stroke-width=1.25
        line x1=1.8 y1=6.2 x2=6.2 y2=1.8 stroke=color stroke-width=1.25 stroke-linecap="round"
    else if mark == "◆"
      svg width=size height=size viewBox="0 0 8 8"
        polygon points="4,0.5 7.5,4 4,7.5 0.5,4" fill=color
    else if mark == "●"
      svg width=size height=size viewBox="0 0 8 8"
        circle cx=4 cy=4 r=3.1 fill=color
    else if mark == "○"
      svg width=size height=size viewBox="0 0 8 8"
        circle cx=4 cy=4 r=3.1 fill="none" stroke=color stroke-width=1.25
    else if mark == "◐"
      svg width=size height=size viewBox="0 0 8 8"
        circle cx=4 cy=4 r=3.1 fill="none" stroke=color stroke-width=1.2
        path d="M4,0.9 A3.1,3.1 0 0 0 4,7.1 Z" fill=color
    else if mark == "✕"
      svg width=size height=size viewBox="0 0 8 8"
        line x1=1.6 y1=1.6 x2=6.4 y2=6.4 stroke=color stroke-width=1.35 stroke-linecap="round"
        line x1=6.4 y1=1.6 x2=1.6 y2=6.4 stroke=color stroke-width=1.35 stroke-linecap="round"
    else if mark != ""
      text mark color=color font-size=(mark == "?" ? 16 : size) font-weight=(mark == "?" ? 600 : 400) line-height=1 text-align="center"
