use InlineText from "./inline-text.contract"
use ButtonLabel from "./action-button.contract"
use Button, Row from "./model.contract"

component RowActions
  props
    item: Row
    optionsShown: bool
    compact: bool
    session: string
    disconnected: bool
    pending: bool
    localActive: bool
    submittedKey: string
    isSendingRow: bool
    onChoose: action
    onLocal: action
  derive buttons = optionsShown ? item.allActions : item.shownActions
  derive answers = optionsShown ? item.allOptions : item.options
  derive answerKeys = answers.map(option => option.button.key)
  view
    column gap=8
      for option, oi in answers key=option.id
        column position="relative" gap=4 align-items="start"
          if item.hasTree
            box position="absolute" left=-17 top=0 height=(oi == answers.length - 1 ? 14 : "100%") border-left="1.5px solid tree.row"
            box position="absolute" left=-17 top=14 width=11 border-top="1.5px solid tree.row"
          RowActionButton(a=option.button, item=item, compact=compact, session=session, disconnected=disconnected, pending=pending, localActive=localActive, submittedKey=submittedKey, isSendingRow=isSendingRow, onChoose=onChoose, onLocal=onLocal)
          if option.body.length > 0 or option.reason.length > 0
            column color="ink.muted" padding-left=13 gap=2
              if option.body.length > 0
                InlineText(parts=option.body)
              if option.reason.length > 0
                InlineText(parts=option.reason)
      row appearance="none" flex-wrap="wrap" align-items="center" gap=8
        for a in buttons.filter(button => not answerKeys.includes(button.key)) key=a.key
          RowActionButton(a=a, item=item, compact=compact, session=session, disconnected=disconnected, pending=pending, localActive=localActive, submittedKey=submittedKey, isSendingRow=isSendingRow, onChoose=onChoose, onLocal=onLocal)

component RowActionButton
  props
    a: Button
    item: Row
    compact: bool
    session: string
    disconnected: bool
    pending: bool
    localActive: bool
    submittedKey: string
    isSendingRow: bool
    onChoose: action
    onLocal: action
  derive isQuiet = a.emphasis == "quiet"
  derive isOutState = a.out or (a.key == submittedKey and isSendingRow)
  derive isDisabled = a.command == "local" ? (a.disabled or disconnected or pending or localActive) : (a.disabled or disconnected or (pending and a.command != "options") or (a.key == submittedKey and isSendingRow))
  derive fgColor = a.primary ? "ink.on-primary" : isQuiet ? "ink.muted" : "ink.primary"
  view
    if a.command == "local"
      button press=onLocal(a, session, item.id, item.version) disabled=isDisabled testId=`action-${a.key}` appearance="none" border-width=(isQuiet ? 0 : 1) border-style="solid" border-color=(isQuiet ? "transparent" : "border.key") border-radius=14 background-color="transparent" padding=(isQuiet ? "4px 6px" : "4px 12px") min-height=(compact ? 28 : 36) opacity=(isOutState or isDisabled ? 0.4 : 1)
        :active
          background-color="surface.soft"
        ButtonLabel(label=a.label, icon=a.icon, color=fgColor)
    else
      button press=onChoose(a.key, a.input, item.id, item.title) disabled=isDisabled testId=`action-${a.key}` appearance="none" border-width=(isQuiet or a.primary ? 0 : 1) border-style="solid" border-color=(a.primary or isQuiet ? "transparent" : "border.key") border-radius=14 background-color=(a.primary ? "ink.primary" : "transparent") padding=(isQuiet ? "4px 6px" : "4px 12px") min-height=(compact ? 28 : 36) opacity=(isOutState or isDisabled ? 0.4 : 1)
        :active
          opacity=0.8
        ButtonLabel(label=a.label, icon=a.icon, color=fgColor)
