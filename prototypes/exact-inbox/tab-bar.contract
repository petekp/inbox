component TabButton
  props
    name: string
    label: string
    icon: string
    selected: bool
    wideWeb: bool
    shown: bool
    onPick: action
  view
    if wideWeb
      button role="tab" aria-controls=`panel-${name}` aria-selected=selected press=onPick(name) testId=`tab-${name}` display=(shown ? "flex" : "none") appearance="none" padding="6px 12px" border-radius=6 border-width=0 background-color=(selected ? "surface.raised" : "transparent") color=(selected ? "ink.primary" : "ink.muted") font-weight=(selected ? 600 : 400) white-space="nowrap"
        :active
          opacity=0.75
        text label font-variant-numeric="tabular-nums"
    else
      button role="tab" aria-controls=`panel-${name}` aria-selected=selected press=onPick(name) testId=`tab-${name}` flex=1 display=(shown ? "flex" : "none") appearance="auto"
        image icon
        text label

component TabBar
  props
    helpShown: bool
    onHelp: action
    asksBadge: string
    findsBadge: string
    prsBadge: string
    tab: string
    wideWeb: bool
    onPick: action
  view
    row role="tablist" appearance=(wideWeb ? "none" : "auto") testId="tabs" margin-left=(wideWeb ? 260 : 0) padding=(wideWeb ? "12px 12px 0 12px" : "0") gap=(wideWeb ? 4 : 0) align-items="center"
      TabButton(name="sessions", label="Sessions", icon="symbol:list", selected=tab == "sessions", wideWeb=wideWeb, shown=not wideWeb, onPick=onPick)
      TabButton(name="status", label="Status", icon="symbol:chart", selected=tab == "status", wideWeb=wideWeb, shown=true, onPick=onPick)
      TabButton(name="asks", label=(asksBadge == "" ? "Asks" : `Asks ${asksBadge}`), icon="symbol:messages", selected=tab == "asks", wideWeb=wideWeb, shown=true, onPick=onPick)
      TabButton(name="findings", label=(findsBadge == "" ? "Finds" : `Finds ${findsBadge}`), icon="symbol:info", selected=tab == "findings", wideWeb=wideWeb, shown=true, onPick=onPick)
      TabButton(name="prs", label=(prsBadge == "" ? "PRs" : `PRs ${prsBadge}`), icon="symbol:repeat", selected=tab == "prs", wideWeb=wideWeb, shown=true, onPick=onPick)

      if wideWeb
        button press=onHelp aria-label=(helpShown ? "Close help" : "Help") aria-pressed=helpShown appearance="none" padding="6px 10px" border-radius=6 border-width=0 background-color=(helpShown ? "surface.raised" : "transparent") color=(helpShown ? "ink.primary" : "ink.muted") font-weight=600 margin-left="auto" testId="help-web"
          :active
            opacity=0.75
          text "?"
