component InboxHeader
  props
    name: string
    connection: string
    readOnly: bool
    readError: string
    mutationError: string
    receiptError: string
    tab: string
  view
    section
      row
        text name font="-exact-subheadline" color="-exact-secondary-label" flex=1
        text connection
          font="-exact-footnote" color="-exact-secondary-label" testId=`connection-${tab}`
      if readOnly
        row
          text "Read-only" font="-exact-footnote" color="-exact-secondary-label"
      if readError != ""
        row
          text readError color="-exact-system-red" testId=`read-error-${tab}`
      if mutationError != ""
        row
          text mutationError color="-exact-system-red" testId=`press-error-${tab}`
      if receiptError != ""
        row
          text receiptError color="-exact-system-red"
