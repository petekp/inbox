use HostBanner from "./model.contract"
component InboxHeader
  props
    banners: HostBanner[]
    busy: bool
    onAction: action
    name: string
    connection: string
    readOnly: bool
    readError: string
    mutationError: string
    receiptError: string
    tab: string
  view
    section
      row
        text name font="-exact-subheadline" color="-exact-secondary-label" flex=1
        text connection
          font="-exact-footnote" color="-exact-secondary-label" testId=`connection-${tab}`
      if readOnly
        row
          text "Read-only" font="-exact-footnote" color="-exact-secondary-label"
      if readError != ""
        row
          text readError color="-exact-system-red" testId=`read-error-${tab}`
      if mutationError != ""
        row
          text mutationError color="-exact-system-red" testId=`press-error-${tab}`
      if receiptError != ""
        row
          text receiptError color="-exact-system-red"

      for banner in banners key=banner.id
        column gap=6 padding=10 background-color="-exact-tertiary-fill" border-radius=8
          text banner.title font-weight=600 color=(banner.tone == "error" ? "-exact-system-red" : "-exact-label")
          if banner.body != ""
            text banner.body color="-exact-secondary-label"
          if banner.key != ""
            button press=onAction(banner.key, false, "session", banner.label) disabled=(banner.disabled or readOnly or busy)
              text banner.label
