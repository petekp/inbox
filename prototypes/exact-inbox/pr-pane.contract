use rowLayout, rowBgFade, rowEntry from "./motion.contract"
use Inbox, isPrRow, VisualPr from "./model.contract"
use InlineText from "./inline-text.contract"
use MarkGlyph from "./mark-glyph.contract"
use ButtonLabel from "./action-button.contract"

component PrPane
  props
    visual: VisualPr[]
    reduced: bool
    inbox: Inbox
    selected: string
    guarded: bool
    compact: bool
    prefix: string
    localActive: bool
    onFold: action
    onAction: action
    busy: bool
    sending: bool
    submittedKey: string
  view
    column gap=0
      if inbox.prNotice != ""
        row margin="4px 16px 8px 16px" padding="8px 12px" border-radius=10 border-width=1 border-style="solid" border-color="banner.error.line" background-color="banner.error.fill"
          text inbox.prNotice color="tone.error"
      if inbox.prEmptyTitle != ""
        column padding="36px 24px" gap=6 align-items="center"
          text inbox.prEmptyTitle font-weight=600 color="ink.primary" text-align="center"
          if inbox.prEmptyHint != ""
            text inbox.prEmptyHint color="ink.muted" text-align="center" max-width=360
      for v in visual key=v.id
        column id=`${prefix}-pr-${v.row.id}` gap=4 padding=(v.target == "gone" ? "0px" : v.row.kind == "block" or v.row.kind == "group" ? "6px 16px 6px 40px" : "6px 16px") background-color=(isPrRow(v.row) and (v.target == "open" or v.phase == "closing") ? "surface.selected" : "transparent") transition=rowBgFade(reduced) height=(v.target == "gone" ? "0px" : "auto") overflow="hidden" inert=(v.target == "gone") aria-hidden=(v.target == "gone") -exact-layout-transition=rowLayout(reduced) animation=rowEntry(reduced, v.arriving)
          if v.row.kind == "block" and not v.row.isFirstBlock
            box height=1 margin="6px 0 10px 0" background-color="surface.soft"
          if isPrRow(v.row)
            button press=onFold(v.row.id, v.row.collapse) appearance="none" background-color="transparent" border-width=0 display="flex" width="100%" min-height=(compact ? 24 : 36) padding=0 text-align="left" align-items="start" aria-expanded=(selected == v.row.id) testId=`pr-select-${v.row.id}`
              row gap=8 align-items="start" width="100%"
                column width=16 padding-top=6 align-items="center"
                  if v.row.mark != "" or v.row.running
                    MarkGlyph(mark=v.row.mark, color=v.row.color, running=v.row.running, reduced=reduced, size=8)
                column flex=1 min-width=0 gap=0
                  text v.row.title color="ink.primary" font-weight=(v.target == "open" or v.phase == "closing" ? 600 : 400) line-clamp=(v.target == "open" or v.phase == "closing" ? 0 : 2) text-overflow=(v.target == "open" or v.phase == "closing" ? "clip" : "ellipsis")
                  if v.row.detail != "" and selected != v.row.id
                    text v.row.detail color="ink.age" line-clamp=1 text-overflow="ellipsis"
          else if v.row.kind == "block"
            text
              text `${v.row.number} ` font-weight=400 color="ink.muted"
              text v.row.title font-weight=600 color="ink.primary"
          else
            text v.row.title font-weight=(v.row.kind == "heading" or v.row.kind == "group" ? 600 : 400) color=(v.row.failed ? "tone.error" : v.row.kind == "group" or v.row.kind == "heading" ? "ink.primary" : "ink.muted")
          if v.row.detail != "" and not isPrRow(v.row)
            text v.row.detail color=(v.row.kind == "block" ? v.row.color : "ink.muted")
          column padding-left=(isPrRow(v.row) ? 24 : 0) gap=6 height=(not isPrRow(v.row) or v.target == "open" ? "auto" : "0px") overflow="hidden" inert=(isPrRow(v.row) and v.target != "open") aria-hidden=(isPrRow(v.row) and v.target != "open") -exact-layout-transition=rowLayout(reduced)
            if v.panel.quote.length > 0
              column white-space="pre-line" color="ink.primary"
                InlineText(parts=v.panel.quote)
            if v.panel.openDetail != ""
              text v.panel.openDetail color="ink.muted"
            if v.panel.reply.length > 0
              column white-space="pre-line" color="ink.primary"
                InlineText(parts=v.panel.reply)
            if v.panel.controls.length > 0
              row appearance="none" gap=8 flex-wrap="wrap" align-items="center" padding-top=2
                for control in v.panel.controls key=control.key
                  button press=onAction(control) disabled=(control.disabled or busy or (control.scope == "row" and (guarded or v.guarded or v.target != "open")) or (control.command == "local" and localActive) or (sending and submittedKey == control.key)) appearance="none" border-width=(control.emphasis == "quiet" or control.primary ? 0 : 1) border-style="solid" border-color=(control.emphasis == "quiet" or control.primary ? "transparent" : "border.key") border-radius=14 background-color=(control.primary ? "ink.primary" : "transparent") padding=(control.emphasis == "quiet" ? "4px 6px" : "4px 12px") min-height=(compact ? 28 : 36) opacity=(control.out or control.disabled or busy or (sending and submittedKey == control.key) ? 0.4 : 1) testId=`pr-action-${control.key}`
                    :active
                      opacity=0.8
                    ButtonLabel(label=control.label, icon=control.icon, color=(control.primary ? "ink.on-primary" : control.emphasis == "quiet" ? "ink.muted" : "ink.primary"))
          if v.localText != ""
            text v.localText padding-left=(isPrRow(v.row) ? 24 : 0) color=(v.localFailed ? "tone.error" : "ink.muted")
          else if sending and v.row.controls.map(c => c.key).includes(submittedKey)
            text "Sending…" padding-left=(isPrRow(v.row) ? 24 : 0) color="ink.muted"
          else if v.row.feedback != ""
            text v.row.feedback padding-left=(isPrRow(v.row) ? 24 : 0) color=(v.row.failed ? "tone.error" : "ink.muted")
