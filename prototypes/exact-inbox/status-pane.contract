use Inbox from "./model.contract"

component StatusPane
  props
    inbox: Inbox
    pending: bool
    prefix: string
    onAction: action
  view
    section
      header
        text inbox.statusLabel
      if pending
        row appearance="none" gap=6
          progress aria-label="Saving goal"
          text "Saving goal…"
      if inbox.statusError != ""
        text inbox.statusError color="-exact-system-red"
      column gap=6 padding="8px 0"
        text inbox.statusTitle font-weight=600
        if inbox.statusWas != ""
          text inbox.statusWas color="-exact-secondary-label"
        if inbox.statusNow != ""
          text inbox.statusNow
        if inbox.statusDetail != ""
          text inbox.statusDetail color="-exact-secondary-label"
        if inbox.statusOffer != ""
          text inbox.statusOffer
        row gap=8 flex-wrap="wrap" appearance="none"
          for a in inbox.statusActions key=a.action
            button press=onAction(a) disabled=(a.disabled or pending or (a.key != "" and (inbox.readOnly or not inbox.connected)))
              text a.label
      for s in inbox.statusRows key=s.id
        column id=`${prefix}-status-${s.id}` gap=4 padding="8px 0" padding-left=(s.depth * 16)
          row gap=6 appearance="none" align-items="start"
            if s.running
              progress aria-label="Working" width=14 height=14
            else if s.mark != ""
              text s.mark color=s.color
            column flex=1 min-width=0 gap=4
              if s.title != ""
                text s.title font-weight=(s.bold ? 600 : 400) color=(s.bold ? "-exact-label" : s.color)
              if s.waitsOn != ""
                text s.waitsOn color="-exact-system-orange"
              if s.detail != ""
                text s.detail color="-exact-secondary-label"
              if s.was != ""
                text s.was color="-exact-secondary-label"
              if s.merged != ""
                text s.merged color="-exact-secondary-label"
              if s.actions.length > 0
                row gap=8 flex-wrap="wrap" appearance="none"
                  for a in s.actions key=a.action
                    button press=onAction(a) disabled=(a.disabled or pending or (a.key != "" and (inbox.readOnly or not inbox.connected)))
                      text a.label
