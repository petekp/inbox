use Inbox from "./model.contract"


component StatusPane
  props
    inbox: Inbox
    prefix: string
  view
    section
      header
        text (inbox.statusTitle != "" ? inbox.statusTitle : "Status")
      if inbox.statusError != ""
        row
          text inbox.statusError color="-exact-system-red"
      if inbox.statusDetail != ""
        row
          text inbox.statusDetail
      for s in inbox.statusRows key=s.id
        row id=`${prefix}-status-${s.id}`
          column flex=1 min-width=0 gap=4 padding-left=(s.depth * 16)
            text `${s.mark} ${s.title}`
            if s.detail != ""
              text s.detail font="-exact-subheadline" color="-exact-secondary-label"
      if inbox.statusTitle == "" and inbox.statusRows.length == 0
        row
          text "Status will appear after the agent’s reply." color="-exact-secondary-label"
