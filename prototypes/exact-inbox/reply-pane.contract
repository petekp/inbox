component ReplyPane
  props
    title: string
    draft: string
    canSend: bool
    canDiscard: bool
    message: string
    tab: string
    onEdit: action
    onDiscard: action
    onSend: action
  view
    section
      header
        text title
      row
        textarea value=draft input=onEdit placeholder="Write a reply…" aria-label="Reply"
          rows=3 flex=1 min-width=0 testId=`reply-${tab}`
      row
        button press=onDiscard disabled=(not canDiscard) testId=`discard-${tab}`
          text "Discard"
        button press=onSend buttonStyle="filled" disabled=(not canSend)
          testId=`send-${tab}`
          text "Send reply"
      footer
        text message
