use rowExit, rowLayout from "./motion.contract"
component ReplyPane
  props
    hint: string
    discardLabel: string
    reduced: bool
    goalReply: bool
    submitLabel: string
    title: string
    draft: string
    canSend: bool
    canDiscard: bool
    message: string
    tab: string
    onEdit: action
    onDiscard: action
    onCancel: action
    onSend: action
  action typedKey(k: string, event: KeyboardEvent)
    if not event.isComposing and k == "Escape"
      onCancel()
      blur()
      preventDefault()
    else if not event.isComposing and k == "Enter" and not event.shiftKey
      if canSend
        onSend()
      preventDefault()
    stopPropagation()
  view
    section -exact-exit-animation=rowExit(reduced) -exact-layout-transition=rowLayout(reduced)
      if title != ""
        header
          text title
      row
        textarea autofocus key=typedKey value=draft input=onEdit placeholder=hint aria-label=(goalReply ? "Goal" : hint)
          rows=3 flex=1 min-width=0 testId=`reply-${tab}`
      row
        button press=onDiscard disabled=(not canDiscard) testId=`discard-${tab}`
          text discardLabel
        button press=onSend buttonStyle="filled" disabled=(not canSend)
          testId=`send-${tab}`
          text submitLabel
      footer
        text message
