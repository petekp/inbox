use Row from "./model.contract"

component InboxRows
  props
    rows: Row[]
    findings: bool
    fresh: bool
    waiting: bool
    selected: string
    submittedRow: string
    submittedKey: string
    isSendingRow: bool
    disconnected: bool
    pending: bool
    onToggle: action
    onChoose: action
  view
    for r in rows key=r.id
      section testId=`row-${r.id}`
        button press=onToggle(r.id) color="-exact-label" testId=`select-${r.id}`
          row gap=10 align-items="start"
            text r.mark color="-exact-secondary-label" width="1em" min-width="1em" text-align="center"
            column flex=1 min-width=0 gap=4
              text r.title
              if r.feedback != "" or (r.id == submittedRow and isSendingRow)
                text (r.id == submittedRow and isSendingRow ? "Sending…" : r.feedback) font="-exact-subheadline" color="-exact-secondary-label" testId=`feedback-${r.id}`
        if selected == r.id
          row
            column flex=1 min-width=0 gap=12 padding-left=22
              if r.context != ""
                text r.context font="-exact-subheadline" color="-exact-secondary-label"
              if r.detail != ""
                text r.detail
              row flex-wrap="wrap" gap=8
                for a in r.actions key=a.key
                  button press=onChoose(a.key, a.input, r.id, r.title) buttonStyle=(a.primary ? "filled" : "bordered")
                    disabled=(a.disabled or disconnected or pending or (a.key == submittedKey and isSendingRow)) testId=`action-${a.key}`
                    text a.label
              if r.recommendation != ""
                text r.recommendation font="-exact-subheadline" color="-exact-secondary-label"
              for a in r.actions.filter(x => x.reason != "") key=a.key
                text a.reason font="-exact-footnote" color="-exact-secondary-label"
    if rows.length == 0 and not disconnected
      section
        row
          text (not fresh ? "Inbox may be out of date." : waiting ? "Open this session in Herdr to handle its pending input." : findings ? "No findings." : "Nothing needed.") color="-exact-secondary-label" testId=`empty-${findings ? "findings" : "asks"}`
