use InlineSpan from "./model.contract"

component InlineText
  props
    parts: InlineSpan[]
  view
    text
      for s in parts key=s.id
        if s.href != ""
          text s.text href=s.href font-weight=(s.bold ? 700 : 400) font-style=(s.italic ? "italic" : "normal") font-family=(s.code ? "monospace" : "inherit") text-decoration=(s.strike ? "line-through" : "none")
        else
          text s.text font-weight=(s.bold ? 700 : 400) font-style=(s.italic ? "italic" : "normal") font-family=(s.code ? "monospace" : "inherit") text-decoration=(s.strike ? "line-through" : "none")
