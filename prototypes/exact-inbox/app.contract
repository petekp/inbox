use LocalOpenTarget from "./app-local-actions.contract"
use InboxBody from "./inbox-body.contract"
use TabBar from "./tab-bar.contract"
use SessionList from "./session-list.contract"
use CollapseEntry, expandedRow, hasOpenRow, LocalFeedback, terminalReceipt, statusSampleVersion, visible, Clock, ViewerAck, sessionPath, Recovery, Inbox, Receipt, Draft, Directory, Place, Navigation, Viewport, Page, firstId, draftFor, replyAction, placeFor, sessionName, containsAction, matchingSessions, urlTab, readProblem from "./model.contract"

routes nav
  tab sessions "/sessions"
  tab asks "/"
  tab status "/status"
  tab findings "/findings"
  tab prs "/prs"


component App
  state selectedSession = ""
  state search = ""
  state listTop = 0
  state listRestore = 0
  state listReady = false
  state places: Place[] = []
  state navigationLoaded = false
  state navigationRevision = 0
  state restoredTop = 0
  state scrollOwner = ""
  state restoreRevision = 0
  state replyId = "" persist
  state drafts: Draft[] = []
  state draftsLoaded = false
  state receiptId = ""
  state recoveredId = ""
  state submittedKey = ""
  state sendingReply = false
  state submittedDraft = ""
  state submittedText = ""
  state submittedRow = ""
  state submittedSession = ""
  state pressError = ""
  state visibleStatus: string[] = []
  state statusSample = ""
  derive statusSampleKey = statusSampleVersion(inbox, selectedSession, top(nav).id)
  members "./app-local-actions.contract"
  state interaction = 0
  state recentInput = false
  mutation viewerAck as shape ViewerAck queue
  resource directory = loadSessions(selectedSession) as shape Directory else empty()
  resource savedNavigation = loadNavigation() as shape Navigation else empty()
  resource viewport = exactViewport() as shape Viewport
  resource page = exactPage() as shape Page
  resource time = exactTime() as shape Clock
  resource inbox = loadInbox(selectedSession) with activePlace.folds, activePlace.collapsed, activePlace.collapses when selectedSession != "" as shape Inbox else empty()
  mutation navigationSaved as shape Receipt queue refreshes savedNavigation
  derive compact = page.navigationType != "" and viewport.width >= 600
  derive wideWeb = page.navigationType != "" and viewport.width >= 960
  derive activePlace = placeFor(places, selectedSession)
  derive expanded = nav.tab == "findings" ? activePlace.findsExpanded : activePlace.asksExpanded
  derive heldReplies = drafts.filter(d => d.session == selectedSession and (d.text.trim() != "" or d.id == replyId)).map(d => d.row)
  derive draftSessions = drafts.filter(d => d.text.trim() != "").map(d => d.session)
  derive matches = matchingSessions(directory.entries, selectedSession, draftSessions, search)
  derive matchingInbox = current(inbox) and inbox.key == selectedSession
  derive shownName = matchingInbox ? inbox.name : activePlace.name
  resource recovery = loadRecovery(selectedSession) when selectedSession != "" as shape Recovery else empty()
  resource savedDrafts = loadDrafts() as shape Draft[] else empty()
  resource receipt = loadReceipt(receiptId) when receiptId != "" as shape Receipt else empty()
  mutation sent as shape Receipt queue refreshes inbox, recovery, savedDrafts then sentPress
  mutation stored as shape Receipt queue refreshes savedDrafts, recovery
  mutation forgotten as shape Receipt queue refreshes recovery, savedDrafts
  derive selected = expandedRow((nav.tab == "findings" ? inbox.findings : inbox.asks), expanded, effectiveCollapsed)
  derive compatibilityError = match failure(inbox) { case some(f) => f.reason == "helper-version" ? f.message : "", case none => "" }
  derive readError = not failed(savedDrafts) and compatibilityError != "" ? compatibilityError : readProblem(failed(savedDrafts), failed(inbox), inbox.failure)
  derive activeDraft = draftFor(drafts, replyId)
  derive draft = activeDraft.text
  derive replyTitle = activeDraft.title
  derive liveReplyKey = activeDraft.row == "goal" ? (activeDraft.key == inbox.statusGoalKey ? inbox.statusGoalKey : "") : replyAction(inbox.asks.concat(inbox.findings), activeDraft.row)
  derive replyOpen = replyId != "" and activeDraft.session == selectedSession and draftsLoaded
  derive replyIsGoal = activeDraft.row == "goal"
  derive replyIsDetached = (not matchingInbox or not hasOpenRow(inbox, activeDraft.row)) and not replyIsGoal
  derive replyTabMatches = (nav.tab == "asks" and inbox.asks.map(r => r.id).includes(activeDraft.row)) or (nav.tab == "findings" and inbox.findings.map(r => r.id).includes(activeDraft.row))
  derive replyVisible = replyOpen and (replyIsDetached or (replyIsGoal and nav.tab == "status") or (replyTabMatches and selected == activeDraft.row))
  derive replyWaiting = submittedSession == selectedSession and receiptId != "" and not failed(receipt) and (receipt.state == "" or receipt.state == "submitted")
  derive replyAvailable = liveReplyKey != "" and activeDraft.session == inbox.key
  derive canSendReply = draft.trim() != "" and not pending(sent) and not pending(forgotten) and not disconnected and replyAvailable and not replyWaiting and not inbox.readOnly
  derive receiptError = failed(receipt) ? "Can’t check delivery. Your reply is kept." : (receipt.state == "unconfirmed" or terminalReceipt(receipt.state)) ? receipt.error : ""
  derive hasConfirmedReceipt = receiptId != "" and receipt.id == receiptId and receipt.state == "confirmed"
  derive draftError = failed(stored) ? "Couldn’t save this reply on the device. Keep Inbox open." : ""
  derive sendError = match sent { case some(r) => r.error, case none => "" }
  derive sentId = match sent { case some(r) => r.id, case none => "" }
  derive wasSubmitted = match sent { case some(r) => r.ok, case none => false }
  derive mutationError = submittedSession != selectedSession ? "" : failed(sent) ? "Couldn’t confirm delivery. Refresh before trying again." : pressError
  derive hostHasNotApplied = containsAction(inbox, submittedRow, submittedKey)
  derive isSendingRow = submittedSession == selectedSession and not disconnected and not failed(sent) and sendError == "" and pressError == "" and (pending(sent) or replyWaiting or (wasSubmitted and hostHasNotApplied))

  members "./app-connection.contract"
  task poll mount
    every(1000, refreshInbox)
  task restoreNavigation when current(savedNavigation) and not pending(savedNavigation) and current(page) and not navigationLoaded
    after(1, restoreNavigation)
  task firstSession when navigationLoaded and selectedSession == "" and current(directory) and directory.defaultId != ""
    after(1, selectDefault)
  task saveNavigation when navigationLoaded and navigationRevision > 0 key=navigationRevision
    after(250, saveNavigation)
  task restoreListLayout when navigationLoaded and current(directory) key=`${wideWeb}:${top(nav).id}`
    after(1, restoreListLayout)
  task alignRouteTab when top(nav).name != nav.tab and (top(nav).name == "sessions" or top(nav).name == "asks" or top(nav).name == "status" or top(nav).name == "findings" or top(nav).name == "prs") key=top(nav).id
    after(1, alignRouteTab)
  task routeChanged when navigationLoaded and searchParam(top(nav), "session") != "" and (searchParam(top(nav), "session") != selectedSession or nav.tab != activePlace.tab) key=top(nav).id
    after(1, restoreRoute)
  task showRailSelection when wideWeb and navigationLoaded and selectedSession != "" and nav.tab == "sessions" key=selectedSession
    after(1, showRailSelection)
  task restoreScroll when matchingInbox and nav.tab != "sessions" key=`${selectedSession}:${nav.tab}:${restoreRevision}:${top(nav).id}`
    after(1, restoreScroll)
  task restore when current(savedDrafts) and not pending(savedDrafts) and not failed(savedDrafts) and not draftsLoaded
    after(1, restoreDrafts)
  state heartbeatQueued = false
  task flushHeartbeat when heartbeatQueued and not pending(viewerAck)
    after(1, renewViewer)
  task heartbeat when selectedSession != ""
    every(15000, renewViewer)
  task viewerChanged when selectedSession != "" key=`${selectedSession}:${page.visibilityState}:${page.onLine}:${helpShown}:${nav.tab}:${heldReplies.join(",")}:${visibleStatus.join(",")}:${statusSample}`
    after(1, renewViewer)
  task activity when interaction > 0 key=interaction
    after(1, interacted)
  task quiet when recentInput key=interaction
    after(1000, quiet)
  task moving when recentInput
    every(500, renewViewer)
  task statusVisibility when nav.tab == "status" and page.visibilityState == "visible" and not helpShown
    every(500, sampleStatus)
  task recover when not pending(sent) and current(recovery) and not pending(recovery) and recovery.id != "" and (submittedSession != selectedSession or (receiptId == "" and recoveredId != recovery.id)) key=`${selectedSession}:${recovery.id}`
    after(1, restorePending)
  task recoveryWake when selectedSession != "" and not disconnected key=selectedSession
    after(1, refreshRecovery)
  task pollReceipt when receiptId != ""
    every(500, refreshReceipt)
  task rejected when receiptId != "" and current(receipt) and terminalReceipt(receipt.state) key=receipt.id
    after(1, settlePending)
  task confirmed when hasConfirmedReceipt key=receipt.id
    after(1, finishPress)

  action interacted
    let startingInput = not recentInput
    recentInput = true
    if startingInput
      sendHeartbeat(true)
  action quiet
    recentInput = false
  action renewViewer
    sendHeartbeat(recentInput)
  action sendHeartbeat(listActive: bool)
    if pending(viewerAck)
      heartbeatQueued = true
    else
      heartbeatQueued = false
      send viewerAck = heartbeat(selectedSession, page.visibilityState == "visible" and page.onLine and nav.tab != "sessions" and not helpShown, nav.tab, heldReplies, (nav.tab == "status" and matchingInbox and statusSample == statusSampleKey ? visibleStatus : []), inbox.updatedAt, time.epochAtZero + performanceNow(), listActive)
  action sampleStatus
    statusSample = statusSampleKey
    let bounds = frame(`content-${top(nav).id}`)
    visibleStatus = inbox.statusRows.filter(s => visible(frame(`content-${top(nav).id}-status-${s.id}`), bounds)).map(s => s.seen).flat()
  action restorePending
    if not pending(sent)
      recoveredId = recovery.id
      submittedSession = recovery.session
      submittedKey = recovery.key
      submittedRow = recovery.row
      submittedDraft = recovery.draft
      submittedText = recovery.text
      receiptId = recovery.id
  members "./app-navigation.contract"
  action refreshRecovery
    refresh recovery
  action manualRefresh
    refreshInbox()
    refresh recovery
  action refreshInbox
    if failed(inbox) or (matchingInbox and not inbox.connected)
      verifiedSession = ""
    if not pending(directory)
      refresh directory
    if not pending(inbox)
      refresh inbox
    if not navigationLoaded and not pending(savedNavigation)
      refresh savedNavigation
    if not draftsLoaded and not pending(savedDrafts)
      refresh savedDrafts
  action restoreDrafts
    drafts = savedDrafts
    draftsLoaded = true
  action refreshReceipt
    refresh receipt
  action follow(url: string)
    helpShown = false
    nav = go(select(nav, urlTab(url)), url)
    navigationRevision = navigationRevision + 1
  action pick(tab: string)
    helpShown = false
    revealAsk = ""
    listRestore = listTop
    scrollOwner = ""
    restoreRevision = restoreRevision + 1
    if tab == "sessions" or selectedSession == ""
      nav = select(nav, "sessions")
    else
      places = places.filter(p => p.id != selectedSession).concat([Place(activePlace, tab=tab)])
      nav = open(nav, sessionPath(tab, selectedSession))
    navigationRevision = navigationRevision + 1
  action toggle(id: string, captured: string)
    foldError = ""
    interaction = interaction + 1
    let isClosing = selected == id
    let canKeep = isClosing and captured != ""
    let value = isClosing and not canKeep ? "closed" : id
    let collapsed = canKeep ? effectiveCollapsed.filter(x => x != id).concat([id]) : effectiveCollapsed.filter(x => x != id)
    let records = activePlace.collapses.filter(entry => entry.id != id)
    let kept = canKeep ? records.concat([CollapseEntry(id=id, value=captured)]) : records
    let nextReply = isClosing and activeDraft.row == id ? "" : replyId
    replyId = nextReply
    places = places.filter(p => p.id != selectedSession).concat([Place(activePlace, reply=nextReply, collapsed=collapsed, collapses=kept, asksExpanded=nav.tab == "asks" ? value : activePlace.asksExpanded, findsExpanded=nav.tab == "findings" ? value : activePlace.findsExpanded)])
    navigationRevision = navigationRevision + 1
  action toggleFold(id: string)
    foldError = ""
    interaction = interaction + 1
    places = places.filter(p => p.id != selectedSession).concat([Place(activePlace, folds=activePlace.folds.includes(id) ? activePlace.folds.filter(x => x != id) : activePlace.folds.concat([id]), earlier=activePlace.earlier.filter(x => x != id))])
    navigationRevision = navigationRevision + 1
  members "./app-status.contract"
  members "./app-selection.contract"
  members "./app-motion.contract"
  members "./app-help.contract"
  members "./app-keyboard.contract"
  members "./app-pr-controls.contract"
  members "./app-collapse.contract"
  action showEarlier(id: string)
    places = places.filter(p => p.id != selectedSession).concat([Place(activePlace, earlier=activePlace.earlier.filter(x => x != id).concat([id]))])
    navigationRevision = navigationRevision + 1
  members "./app-replies.contract"

  view
    main key=keyPressed navigationKey=`${top(nav).id}` navigate=follow testId="app" width="100%" height="100%" font="-exact-body" font-size=(compact ? "13px" : "inherit") line-height=(compact ? "20px" : "normal") background-color="surface.bg" color="ink.primary"
      display="flex" flex-direction="column"
      column position="absolute" left=0 top=0 bottom=0 width=260 box-sizing="border-box" display=(wideWeb ? "flex" : "none") padding="12px 10px" gap=8 background-color="surface.rail" border-right="1px solid surface.soft" testId="session-rail"
        text "Sessions" role="heading" aria-level=2 font-size=15 font-weight=600 padding="0 6px"
        SessionList(entries=matches, search=search, selected=selectedSession, error=(failed(directory) ? "Can’t read your sessions." : directory.error), loading=not current(directory), rail=true, restoreTop=listRestore, onScroll=listScrolled(true), onSearch=searchSessions, onSelect=selectSession)
      if wideWeb
        TabBar(helpShown=helpShown, onHelp=toggleHelp, asksBadge=(matchingInbox ? inbox.asksBadge : ""), findsBadge=(matchingInbox ? inbox.findsBadge : ""), prsBadge=(matchingInbox ? inbox.prsBadge : ""), tab=nav.tab, wideWeb=true, onPick=pick)
      column flex=1 min-height=0 position="relative" margin-left=(wideWeb ? 260 : 0)
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` navigationScroll=`content-${e.id}` position="absolute" inset=0
                display="flex" flex-direction="column"
                header display=(wideWeb ? "none" : "flex") align-items="center" padding="8px 16px"
                  text (t.name == "sessions" ? "Sessions" : shownName) role="heading" aria-level=1 flex=1
                  button press=toggleHelp aria-label=(helpShown ? "Close help" : "Help") testId=`help-${t.name}`
                    text (helpShown ? "Done" : "?")
                  button press=manualRefresh aria-label="Refresh Inbox" testId=`refresh-${t.name}`
                    text "Refresh"
                if failed(savedNavigation) or failed(navigationSaved)
                  text (failed(savedNavigation) ? "Can’t read your saved navigation. Refresh to try again." : "Couldn’t save your place. Keep Inbox open.") color="-exact-system-red"
                if t.name == "sessions" and wideWeb
                  text "Choose a session from the list." padding=24 color="-exact-secondary-label"
                else if t.name == "sessions"
                  SessionList(entries=matches, search=search, selected=selectedSession, error=(failed(directory) ? "Can’t read your sessions." : directory.error), loading=not current(directory), rail=false, restoreTop=listRestore, onScroll=listScrolled(false), onSearch=searchSessions, onSelect=selectSession)
                else
                  InboxBody(prFrameReady=prFrameReady, sendLabel=keyMap.sendLabel, discardLabel=keyMap.discardLabel, selectedPr=selectedPr, prGuarded=prGuarded, onPrAction=prAction, collapsed=effectiveCollapsed, onPrFold=clickPrFold, helpShown=helpShown, helpInfo=helpInfo, helpLoading=not current(helpInfo), helpFailed=failed(helpInfo), visual=visualFrame, reduced=viewport.prefersReducedMotion, inbox=inbox, compact=compact, localActive=localActive, onLocal=startLocal, onStatus=statusPressed, tab=t.name, contentId=`content-${e.id}`, top=restoredTop, matching=matchingInbox and visualFrame.session == selectedSession, draftsLoaded=draftsLoaded, name=shownName, connection=connectionLabel, readError=readError, actionError=(foldErrorSession == selectedSession and foldError != "" ? foldError : mutationError), receiptError=(submittedSession == selectedSession and receiptId != "" ? receiptError : ""), selected=selected, optionsShown=activePlace.options, folds=activePlace.folds, earlier=activePlace.earlier, submittedRow=submittedRow, submittedKey=submittedKey, isSendingRow=isSendingRow, disconnected=disconnected, busy=(pending(sent) or pending(forgotten)), saved=drafts.filter(d => d.session == selectedSession and d.text.trim() != "" and (d.id != replyId or not replyVisible)), replyOpen=replyVisible, replyTitle=replyTitle, replyRow=activeDraft.row, goalReply=activeDraft.row == "goal", replyText=draft, canSend=canSendReply, replyMessage=(draftError != "" ? draftError : replyWaiting ? (activeDraft.row == "goal" ? "Saving goal…" : "Waiting for the agent…") : disconnected ? "Reconnect to send. Your reply is kept." : not replyAvailable ? "This item changed. Your draft is kept." : ""), onScroll=scrolled(e.id, t.name), onToggle=clickRow, onFold=clickFold, onEarlier=showEarlier, onChoose=choose, onOpen=openSavedReply, onEdit=edit, onDiscard=discard, onCancel=cancelReply, onSend=sendReply)
      LocalOpenTarget(sequence=localSequence, index=localIndex, onOpened=localOpened)
      if not wideWeb
        TabBar(helpShown=helpShown, onHelp=toggleHelp, asksBadge=(matchingInbox ? inbox.asksBadge : ""), findsBadge=(matchingInbox ? inbox.findsBadge : ""), prsBadge=(matchingInbox ? inbox.prsBadge : ""), tab=nav.tab, wideWeb=false, onPick=pick)
