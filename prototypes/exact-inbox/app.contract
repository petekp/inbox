use InboxBody from "./inbox-body.contract"
use TabBar from "./tab-bar.contract"
use SessionList from "./session-list.contract"
use terminalReceipt, statusSampleVersion, visible, ViewerAck, sessionPath, Recovery, Inbox, Receipt, Draft, Directory, Place, Navigation, Viewport, Page, firstId, draftFor, replyAction, placeFor, sessionName, savedReply, connectionText, containsAction, matchingSessions, urlTab, readProblem from "./model.contract"

routes nav
  tab sessions "/sessions"
  tab asks "/"
  tab status "/status"
  tab findings "/findings"
  tab prs "/prs"


component App
  state selectedSession = ""
  state search = ""
  state listTop = 0
  state listRestore = 0
  state listReady = false
  state places: Place[] = []
  state navigationLoaded = false
  state navigationRevision = 0
  state restoredTop = 0
  state scrollOwner = ""
  state restoreRevision = 0
  state replyId = "" persist
  state drafts: Draft[] = []
  state draftsLoaded = false
  state draftRevision = 0
  state receiptId = ""
  state recoveredId = ""
  state submittedKey = ""
  state sendingReply = false
  state submittedDraft = ""
  state submittedText = ""
  state submittedRow = ""
  state submittedSession = ""
  state pressError = ""
  state visibleStatus: string[] = []
  state statusSample = ""
  derive statusSampleKey = statusSampleVersion(inbox, selectedSession, top(nav).id)
  state interaction = 0
  state recentInput = false
  mutation viewerAck as shape ViewerAck queue
  resource directory = loadSessions() as shape Directory else empty()
  resource savedNavigation = loadNavigation() as shape Navigation else empty()
  resource viewport = exactViewport() as shape Viewport
  resource page = exactPage() as shape Page
  resource inbox = loadInbox(selectedSession) when selectedSession != "" as shape Inbox else empty()
  mutation navigationSaved as shape Receipt queue
  derive wideWeb = page.navigationType != "" and viewport.width >= 960
  derive activePlace = placeFor(places, selectedSession)
  derive expanded = nav.tab == "findings" ? activePlace.findsExpanded : activePlace.asksExpanded
  derive heldReplies = drafts.filter(d => d.session == selectedSession and (d.text.trim() != "" or d.id == replyId)).map(d => d.row)
  derive draftSessions = drafts.filter(d => d.text.trim() != "").map(d => d.session)
  derive matches = matchingSessions(directory.entries, selectedSession, draftSessions, search)
  derive matchingInbox = current(inbox) and inbox.key == selectedSession
  derive shownName = matchingInbox ? inbox.name : activePlace.name
  resource recovery = loadRecovery(selectedSession) when selectedSession != "" as shape Recovery else empty()
  resource savedDrafts = loadDrafts() as shape Draft[] else empty()
  resource receipt = loadReceipt(receiptId) when receiptId != "" as shape Receipt else empty()
  mutation sent as shape Receipt queue refreshes inbox then sentPress
  mutation stored as shape Receipt queue
  mutation forgotten as shape Receipt queue refreshes recovery
  derive selected = expanded != "" ? expanded : firstId(nav.tab == "findings" ? inbox.findings : inbox.asks)
  derive disconnected = not matchingInbox or not inbox.connected or failed(inbox)
  derive connectionLabel = not current(inbox) and not failed(inbox) ? "Connecting…" : connectionText(inbox, disconnected)
  derive readError = readProblem(failed(savedDrafts), failed(inbox), inbox.failure)
  derive activeDraft = draftFor(drafts, replyId)
  derive draft = activeDraft.text
  derive replyTitle = activeDraft.title
  derive liveReplyKey = replyAction(inbox.asks.concat(inbox.findings), activeDraft.row)
  derive replyOpen = replyId != "" and activeDraft.session == inbox.key and matchingInbox
  derive replyWaiting = receiptId != "" and not failed(receipt) and (receipt.state == "" or receipt.state == "submitted")
  derive replyAvailable = liveReplyKey != "" and activeDraft.session == inbox.key
  derive canSendReply = draft.trim() != "" and not pending(sent) and not pending(forgotten) and not disconnected and replyAvailable and not replyWaiting and not inbox.readOnly
  derive receiptError = failed(receipt) ? "Can’t check delivery. Your reply is kept." : (receipt.state == "unconfirmed" or terminalReceipt(receipt.state)) ? receipt.error : ""
  derive hasConfirmedReceipt = receiptId != "" and receipt.id == receiptId and receipt.state == "confirmed"
  derive draftError = failed(stored) ? "Couldn’t save this reply on the device. Keep Inbox open." : ""
  derive sendError = match sent { case some(r) => r.error, case none => "" }
  derive sentId = match sent { case some(r) => r.id, case none => "" }
  derive wasSubmitted = match sent { case some(r) => r.ok, case none => false }
  derive mutationError = submittedSession != selectedSession ? "" : failed(sent) ? "Couldn’t confirm delivery. Refresh before trying again." : pressError
  derive hostHasNotApplied = containsAction(inbox, submittedRow, submittedKey)
  derive isSendingRow = submittedSession == selectedSession and not disconnected and not failed(sent) and sendError == "" and pressError == "" and (pending(sent) or (wasSubmitted and hostHasNotApplied))

  task poll mount
    every(1000, refreshInbox)
  task restoreNavigation when current(savedNavigation) and not navigationLoaded
    after(1, restoreNavigation)
  task firstSession when navigationLoaded and selectedSession == "" and current(directory) and directory.defaultId != ""
    after(1, selectDefault)
  task saveNavigation when navigationLoaded and navigationRevision > 0 key=navigationRevision
    after(250, saveNavigation)
  task restoreListLayout when navigationLoaded and current(directory) key=`${wideWeb}:${top(nav).id}`
    after(1, restoreListLayout)
  task alignRouteTab when top(nav).name != nav.tab and (top(nav).name == "sessions" or top(nav).name == "asks" or top(nav).name == "status" or top(nav).name == "findings" or top(nav).name == "prs") key=top(nav).id
    after(1, alignRouteTab)
  task routeChanged when navigationLoaded and searchParam(top(nav), "session") != "" and (searchParam(top(nav), "session") != selectedSession or nav.tab != activePlace.tab) key=top(nav).id
    after(1, restoreRoute)
  task showRailSelection when wideWeb and navigationLoaded and selectedSession != "" and nav.tab == "sessions" key=selectedSession
    after(1, showRailSelection)
  task restoreReply when draftsLoaded and matchingInbox and not replyOpen and savedReply(drafts, inbox.key) != "" key=selectedSession
    after(1, restoreReply)
  task restoreScroll when matchingInbox and nav.tab != "sessions" key=`${selectedSession}:${nav.tab}:${restoreRevision}:${top(nav).id}`
    after(1, restoreScroll)
  task restore when current(savedDrafts) and not draftsLoaded
    after(1, restoreDrafts)
  task save when draftRevision > 0 key=draftRevision
    after(250, saveDrafts)
  task heartbeat when selectedSession != ""
    every(15000, renewViewer)
  task viewerChanged when selectedSession != "" key=`${selectedSession}:${page.visibilityState}:${page.onLine}:${nav.tab}:${heldReplies.join(",")}:${visibleStatus.join(",")}:${statusSample}`
    after(1, renewViewer)
  task activity when interaction > 0 key=interaction
    after(1, interacted)
  task quiet when recentInput key=interaction
    after(1000, quiet)
  task moving when recentInput
    every(500, renewViewer)
  task statusVisibility when nav.tab == "status" and page.visibilityState == "visible"
    every(500, sampleStatus)
  task recover when not pending(sent) and current(recovery) and recovery.id != "" and (submittedSession != selectedSession or (receiptId == "" and recoveredId != recovery.id)) key=`${selectedSession}:${recovery.id}`
    after(1, restorePending)
  task pollReceipt when receiptId != ""
    every(500, refreshReceipt)
  task rejected when receiptId != "" and current(receipt) and terminalReceipt(receipt.state) key=receipt.id
    after(1, settlePending)
  task confirmed when hasConfirmedReceipt key=receipt.id
    after(1, finishPress)

  action interacted
    recentInput = true
    sendHeartbeat(true)
  action quiet
    recentInput = false
  action renewViewer
    sendHeartbeat(recentInput)
  action sendHeartbeat(listActive: bool)
    send viewerAck = heartbeat(selectedSession, page.visibilityState == "visible" and page.onLine and nav.tab != "sessions", nav.tab, heldReplies, (nav.tab == "status" and matchingInbox and statusSample == statusSampleKey ? visibleStatus : []), inbox.updatedAt, performanceNow(), listActive)
  action sampleStatus
    statusSample = statusSampleKey
    let bounds = frame(`content-${top(nav).id}`)
    visibleStatus = inbox.statusRows.filter(s => visible(frame(`content-${top(nav).id}-status-${s.id}`), bounds)).map(s => s.id)
  action restorePending
    if not pending(sent)
      recoveredId = recovery.id
      submittedSession = recovery.session
      submittedKey = recovery.key
      submittedRow = recovery.row
      submittedDraft = recovery.draft
      submittedText = recovery.text
      receiptId = recovery.id
  action restoreListLayout
    listRestore = listTop
    listReady = true
  action alignRouteTab
    nav = replace(select(nav, top(nav).name), top(nav).url)
  action restoreNavigation
    places = savedNavigation.places
    let nextSession = searchParam(top(nav), "session") != "" ? searchParam(top(nav), "session") : savedNavigation.selected
    selectedSession = nextSession
    search = savedNavigation.search
    listTop = savedNavigation.listTop
    let rememberedReply = placeFor(savedNavigation.places, nextSession).reply
    replyId = rememberedReply != "" ? rememberedReply : replyId
    if searchParam(top(nav), "session") == "" and nextSession != "" and (nav.tab == "asks" or (nav.tab == "sessions" and savedNavigation.tab != "sessions"))
      let kept = placeFor(savedNavigation.places, nextSession)
      nav = replace(select(nav, kept.tab), sessionPath(kept.tab, nextSession))
    navigationLoaded = true
  action saveNavigation
    send navigationSaved = saveNavigation(selectedSession, search, places, nav.tab, listTop)
  action selectDefault
    selectedSession = directory.defaultId
    if wideWeb and nav.tab == "sessions"
      nav = open(nav, sessionPath("asks", directory.defaultId))
    places = places.concat([Place(placeFor(places, directory.defaultId), name=sessionName(directory.entries, directory.defaultId))])
    navigationRevision = navigationRevision + 1
  action restoreRoute
    let id = searchParam(top(nav), "session")
    let kept = placeFor(places, id)
    selectedSession = id
    replyId = kept.reply
    places = places.filter(p => p.id != id).concat([Place(kept, tab=nav.tab)])
    scrollOwner = ""
    restoreRevision = restoreRevision + 1
    navigationRevision = navigationRevision + 1
  action listScrolled(rail: bool, x: number, y: number)
    if listReady and navigationLoaded and current(directory) and rail == wideWeb and (rail or nav.tab == "sessions")
      listTop = max(0, y)
      navigationRevision = navigationRevision + 1
  action searchSessions(value: string)
    search = value
    listTop = 0
    listRestore = 0
    navigationRevision = navigationRevision + 1
  action selectSession(id: string)
    let kept = placeFor(places, id)
    places = places.filter(p => p.id != id).concat([Place(kept, name=sessionName(directory.entries, id))])
    selectedSession = id
    scrollOwner = ""
    restoreRevision = restoreRevision + 1
    replyId = kept.reply
    nav = open(nav, sessionPath(kept.tab, id))
    navigationRevision = navigationRevision + 1
  action showRailSelection
    nav = replace(select(nav, activePlace.tab), sessionPath(activePlace.tab, selectedSession))
    scrollOwner = ""
    restoreRevision = restoreRevision + 1
    navigationRevision = navigationRevision + 1
  action restoreReply
    let id = savedReply(drafts, inbox.key)
    replyId = id
    places = places.filter(p => p.id != selectedSession).concat([Place(activePlace, reply=id)])
    navigationRevision = navigationRevision + 1
  action openSavedReply(id: string)
    replyId = id
    places = places.filter(p => p.id != selectedSession).concat([Place(activePlace, reply=id)])
    navigationRevision = navigationRevision + 1
  action restoreScroll
    restoredTop = nav.tab == "status" ? activePlace.statusTop : nav.tab == "findings" ? activePlace.findsTop : activePlace.asksTop
    scrollOwner = `${selectedSession}:${nav.tab}:${top(nav).id}`
  action scrolled(routeId: number, tab: string, x: number, y: number)
    interaction = interaction + 1
    if matchingInbox and nav.tab == tab and scrollOwner == `${selectedSession}:${tab}:${routeId}` and top(nav).id == routeId
      places = places.filter(p => p.id != selectedSession).concat([Place(activePlace, asksTop=tab == "asks" ? max(0, y) : activePlace.asksTop, findsTop=tab == "findings" ? max(0, y) : activePlace.findsTop, statusTop=tab == "status" ? max(0, y) : activePlace.statusTop)])
      navigationRevision = navigationRevision + 1
  action refreshInbox
    refresh directory
    refresh inbox
    if not navigationLoaded
      refresh savedNavigation
    if not draftsLoaded
      refresh savedDrafts
  action restoreDrafts
    drafts = savedDrafts
    draftsLoaded = true
  action saveDrafts
    send stored = saveDrafts(drafts)
  action refreshReceipt
    refresh receipt
  action follow(url: string)
    nav = go(select(nav, urlTab(url)), url)
    navigationRevision = navigationRevision + 1
  action pick(tab: string)
    listRestore = listTop
    scrollOwner = ""
    restoreRevision = restoreRevision + 1
    if tab == "sessions" or selectedSession == ""
      nav = select(nav, "sessions")
    else
      places = places.filter(p => p.id != selectedSession).concat([Place(activePlace, tab=tab)])
      nav = open(nav, sessionPath(tab, selectedSession))
    navigationRevision = navigationRevision + 1
  action toggle(id: string)
    interaction = interaction + 1
    let value = selected == id ? "closed" : id
    places = places.filter(p => p.id != selectedSession).concat([Place(activePlace, asksExpanded=nav.tab == "asks" ? value : activePlace.asksExpanded, findsExpanded=nav.tab == "findings" ? value : activePlace.findsExpanded)])
    navigationRevision = navigationRevision + 1
  action choose(key: string, input: bool, row: string, title: string)
    interaction = interaction + 1
    if input
      let id = `${inbox.key}:${row}`
      let kept = draftFor(drafts, id)
      drafts = drafts.filter(d => d.id != id).concat([Draft(id=id, row=row, session=inbox.key, title=title, key=key, text=kept.text)])
      draftRevision = draftRevision + 1
      replyId = id
      places = places.filter(p => p.id != selectedSession).concat([Place(activePlace, reply=id)])
      navigationRevision = navigationRevision + 1
    else
      receiptId = ""
      submittedDraft = ""
      submittedText = ""
      submittedSession = selectedSession
      submittedKey = key
      submittedRow = row
      sendingReply = false
      pressError = ""
      send sent = press(selectedSession, key, "", row, "")
  action edit(v: string)
    interaction = interaction + 1
    drafts = drafts.map(d => d.id == replyId ? Draft(d, text=v) : d)
    draftRevision = draftRevision + 1
  action sendReply
    if canSendReply
      receiptId = ""
      submittedSession = selectedSession
      submittedKey = liveReplyKey
      submittedRow = activeDraft.row
      submittedDraft = replyId
      submittedText = draft
      sendingReply = true
      pressError = ""
      send sent = press(selectedSession, liveReplyKey, draft, activeDraft.row, replyId)
  action discard
    send stored = discardDraft(replyId)
    drafts = drafts.filter(d => d.id != replyId)
    draftRevision = draftRevision + 1
    replyId = ""
    places = places.filter(p => p.id != selectedSession).concat([Place(activePlace, reply="")])
    navigationRevision = navigationRevision + 1
  action sentPress
    pressError = sendError
    if sentId != ""
      receiptId = sentId
  action settlePending
    if receiptId != "" and receipt.id == receiptId
      pressError = receipt.error
      recoveredId = receiptId
      send forgotten = forgetPending(receiptId, false)
      receiptId = ""
  action finishPress
    if hasConfirmedReceipt
      let isUnedited = draftFor(drafts, submittedDraft).text == submittedText
      if isUnedited
        drafts = drafts.filter(d => d.id != submittedDraft)
        places = places.map(p => p.reply == submittedDraft ? Place(p, reply="") : p)
        navigationRevision = navigationRevision + 1
        draftRevision = draftRevision + 1
        if replyId == submittedDraft
          replyId = ""
      send forgotten = forgetPending(receiptId, true)
      receiptId = ""
      submittedDraft = ""
      submittedText = ""
      refresh inbox

  view
    main navigationKey=`${top(nav).id}` navigate=follow testId="app" width="100%" height="100%"
      display="flex" flex-direction="column"
      column position="absolute" left=0 top=0 bottom=0 width=260 display=(wideWeb ? "flex" : "none") padding=16 gap=12 background-color="-exact-secondary-background" testId="session-rail"
        text "Sessions" role="heading" aria-level=1
        SessionList(entries=matches, search=search, selected=selectedSession, error=(failed(directory) ? "Can’t read your sessions." : directory.error), loading=not current(directory), rail=true, restoreTop=listRestore, onScroll=listScrolled(true), onSearch=searchSessions, onSelect=selectSession)
      column flex=1 min-height=0 position="relative" margin-left=(wideWeb ? 260 : 0)
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` navigationScroll=`content-${e.id}` position="absolute" inset=0
                display="flex" flex-direction="column"
                header display="flex" align-items="center" padding="8px 16px"
                  text "Inbox" role="heading" aria-level=1 flex=1
                  button press=refreshInbox aria-label="Refresh Inbox" testId=`refresh-${t.name}`
                    text "Refresh"
                if failed(savedNavigation) or failed(navigationSaved)
                  text (failed(savedNavigation) ? "Can’t read your saved navigation. Refresh to try again." : "Couldn’t save your place. Keep Inbox open.") color="-exact-system-red"
                if t.name == "sessions" and wideWeb
                  text "Choose a session from the list." padding=24 color="-exact-secondary-label"
                else if t.name == "sessions"
                  SessionList(entries=matches, search=search, selected=selectedSession, error=(failed(directory) ? "Can’t read your sessions." : directory.error), loading=not current(directory), rail=false, restoreTop=listRestore, onScroll=listScrolled(false), onSearch=searchSessions, onSelect=selectSession)
                else
                  InboxBody(inbox=inbox, tab=t.name, contentId=`content-${e.id}`, top=restoredTop, matching=matchingInbox, draftsLoaded=draftsLoaded, name=shownName, connection=connectionLabel, readError=readError, actionError=mutationError, receiptError=(submittedSession == selectedSession and receiptId != "" ? receiptError : ""), selected=selected, submittedRow=submittedRow, submittedKey=submittedKey, isSendingRow=isSendingRow, disconnected=disconnected, busy=(pending(sent) or pending(forgotten)), saved=drafts.filter(d => d.session == inbox.key and d.text.trim() != "" and d.id != replyId), replyOpen=replyOpen, replyTitle=replyTitle, replyText=draft, canSend=canSendReply, replyMessage=(draftError != "" ? draftError : replyWaiting ? "Waiting for the agent…" : not replyAvailable ? "This item changed. Your draft is kept." : ""), onScroll=scrolled(e.id, t.name), onToggle=toggle, onChoose=choose, onOpen=openSavedReply, onEdit=edit, onDiscard=discard, onSend=sendReply)
      TabBar(tab=nav.tab, wideWeb=wideWeb, onPick=pick)
