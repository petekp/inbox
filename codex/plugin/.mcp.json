{
  "mcpServers": {
    "inbox": {
      "command": "/bin/sh",
      "args": ["-c", "exec \"${CODEX_MCP_NODE_PATH:-node}\" ./dist/server.mjs"],
      "cwd": ".",
      "env_vars": [
        "PATH",
        "HOME",
        "CODEX_HOME",
        "CODEX_CLI_PATH",
        "CODEX_MCP_NODE_PATH",
        "HC_TERMINAL_ID",
        "HC_TERMINAL_SOCKET",
        "HERDR_APP_HOME"
      ],
      "default_tools_approval_mode": "approve"
    }
  }
}
