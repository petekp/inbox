{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_MCP_NODE_PATH:-node}\" \"${PLUGIN_ROOT}/dist/hook.mjs\"",
            "statusMessage": "Inbox: loading this chat's inbox"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_MCP_NODE_PATH:-node}\" \"${PLUGIN_ROOT}/dist/hook.mjs\"",
            "statusMessage": "Inbox: giving Codex the inbox"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|mcp__.*|.*spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_MCP_NODE_PATH:-node}\" \"${PLUGIN_ROOT}/dist/hook.mjs\"",
            "statusMessage": "Inbox: noting what Codex runs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_MCP_NODE_PATH:-node}\" \"${PLUGIN_ROOT}/dist/hook.mjs\"",
            "statusMessage": "Inbox: starting the inbox update",
            "timeout": 60
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_MCP_NODE_PATH:-node}\" \"${PLUGIN_ROOT}/dist/hook.mjs\"",
            "statusMessage": "Inbox: noting the interrupt",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_MCP_NODE_PATH:-node}\" \"${PLUGIN_ROOT}/dist/hook.mjs\"",
            "statusMessage": "Inbox: noting the subagent",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_MCP_NODE_PATH:-node}\" \"${PLUGIN_ROOT}/dist/hook.mjs\"",
            "statusMessage": "Inbox: noting the subagent",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
