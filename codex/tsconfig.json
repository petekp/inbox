{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "claude-code": ["../.claude-plugin/types/claude-code"]
    }
  },
  "include": [
    "src",
    "tests",
    "../hooks/ledger.ts",
    "../hooks/checks.ts",
    "../hooks/check-tracking.ts",
    "../hooks/git.ts"
  ]
}
